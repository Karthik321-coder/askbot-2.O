{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
{
  "headers":[
    {"source":"/(.*)","headers":[
      {"key":"Content-Security-Policy",
       "value":"default-src 'self'; script-src 'self' https://checkout.razorpay.com"},
      {"key":"Strict-Transport-Security","value":"max-age=63072000; includeSubDomains"}
    ]}
  ]
}
