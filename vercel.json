{
  "version": 2,
  "builds": [
    {
      "src": "index1.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/generate",
      "dest": "/index1.js"
    },
    {
      "src": "/api/analytics", 
      "dest": "/index1.js"
    },
    {
      "src": "/api/hello",
      "dest": "/index1.js"
    },
    {
      "src": "/api",
      "dest": "/index1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}

